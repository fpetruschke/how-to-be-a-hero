#!/usr/bin/env node
/**
 * Scannt `assets/charaktervorlagen/` nach `*.json` (außer `index.json`)
 * und schreibt ein Manifest mit Metadaten für die App.
 *
 * Aufruf: ./bin/aktualisiere-charaktervorlagen-index
 */

'use strict';

const fs = require('fs');
const path = require('path');

const ROOT_DIR = path.resolve(__dirname, '..');
const VERZEICHNIS = path.join(ROOT_DIR, 'assets', 'charaktervorlagen');
const INDEX_PFAD = path.join(VERZEICHNIS, 'index.json');

function fehler(text) {
  console.error(`Fehler: ${text}`);
  process.exitCode = 1;
}

function leseJsonDatei(dateiPfad) {
  try {
    const roh = fs.readFileSync(dateiPfad, 'utf8');
    return { ok: true, daten: JSON.parse(roh) };
  } catch (err) {
    return { ok: false, fehler: err && err.message ? err.message : String(err) };
  }
}

function alleJsonDateien(dir, basis = '') {
  const out = [];
  if (!fs.existsSync(dir)) {
    return out;
  }
  for (const name of fs.readdirSync(dir)) {
    const voll = path.join(dir, name);
    const rel = basis ? `${basis}/${name}` : name;
    if (fs.statSync(voll).isDirectory()) {
      out.push(...alleJsonDateien(voll, rel));
      continue;
    }
    if (/\.json$/i.test(name) && name.toLowerCase() !== 'index.json') {
      out.push(rel.replace(/\\/g, '/'));
    }
  }
  return out.sort((a, b) => a.localeCompare(b, 'de'));
}

function eintragAusVorlage(relPfad, daten) {
  if (!daten || typeof daten !== 'object') {
    return { ok: false, fehler: 'kein Objekt' };
  }
  if (daten.htbahVorlageVersion !== 1) {
    return { ok: false, fehler: 'Erwartet htbahVorlageVersion: 1' };
  }
  const id = typeof daten.id === 'string' ? daten.id.trim() : '';
  const name = typeof daten.name === 'string' ? daten.name.trim() : '';
  const epoche = typeof daten.epoche === 'string' ? daten.epoche.trim() : '';
  const presetId = typeof daten.presetId === 'string' ? daten.presetId.trim() : '';
  if (!id || !name || !epoche) {
    return { ok: false, fehler: 'id, name oder epoche fehlt' };
  }
  const eintrag = {
    datei: relPfad,
    id,
    name,
    epoche,
    presetId,
  };
  if (typeof daten.untertitel === 'string' && daten.untertitel.trim()) {
    eintrag.untertitel = daten.untertitel.trim();
  }
  if (typeof daten.beruf === 'string' && daten.beruf.trim()) {
    eintrag.beruf = daten.beruf.trim();
  }
  return { ok: true, eintrag };
}

function main() {
  if (!fs.existsSync(VERZEICHNIS) || !fs.statSync(VERZEICHNIS).isDirectory()) {
    fehler(`Verzeichnis fehlt: ${VERZEICHNIS}`);
    return;
  }

  const dateien = alleJsonDateien(VERZEICHNIS);
  const eintraege = [];
  const warnungen = [];
  const ids = new Set();

  dateien.forEach((rel) => {
    const pfad = path.join(VERZEICHNIS, rel);
    const ergebnis = leseJsonDatei(pfad);
    if (!ergebnis.ok) {
      warnungen.push(`${rel}: ungültiges JSON (${ergebnis.fehler}). Übersprungen.`);
      return;
    }
    const eintrag = eintragAusVorlage(rel, ergebnis.daten);
    if (!eintrag.ok) {
      warnungen.push(`${rel}: ${eintrag.fehler}. Übersprungen.`);
      return;
    }
    if (ids.has(eintrag.eintrag.id)) {
      warnungen.push(`${rel}: doppelte id „${eintrag.eintrag.id}“. Übersprungen.`);
      return;
    }
    ids.add(eintrag.eintrag.id);
    eintraege.push(eintrag.eintrag);
  });

  fs.writeFileSync(INDEX_PFAD, JSON.stringify(eintraege, null, 2) + '\n', 'utf8');

  console.log(`Schrieb ${path.relative(ROOT_DIR, INDEX_PFAD)} mit ${eintraege.length} Einträgen:`);
  eintraege.forEach((e) => console.log(`  - ${e.datei}: ${e.name} (${e.epoche})`));
  if (warnungen.length) {
    console.warn('\nHinweise:');
    warnungen.forEach((w) => console.warn(`  • ${w}`));
  }
}

main();
