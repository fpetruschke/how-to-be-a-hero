#!/usr/bin/env bash
# Aktualisiert Charaktervorlagen-Manifest und prüft alle Vorlagen gegen die Presets.
#
# Führt nacheinander aus:
#   1. bin/aktualisiere-charaktervorlagen-index
#   2. bin/validiere-charaktervorlagen
#
# Aufruf: ./bin/aktualisiere-vorlagen

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

INDEX_GENERATOR="bin/aktualisiere-charaktervorlagen-index"
VALIDATOR="bin/validiere-charaktervorlagen"

for script in "$INDEX_GENERATOR" "$VALIDATOR"; do
  if [[ ! -x "$script" ]]; then
    echo "Fehler: Skript fehlt oder ist nicht ausführbar: $script" >&2
    exit 1
  fi
done

echo "==> Manifest aktualisieren …"
"$INDEX_GENERATOR"

echo
echo "==> Vorlagen validieren …"
"$VALIDATOR"

echo
echo "Fertig: Charaktervorlagen-Manifest und Validierung abgeschlossen."
